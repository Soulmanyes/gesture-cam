# Installing (see README) writes the full path of the gesture-cam script into Exec.
[Desktop Entry]
Type=Application
Name=Gesture Cam
GenericName=Webcam Effects
Comment=Webcam gesture effects for video calls and camera apps
Exec=gesture-cam
Icon=camera-web
Terminal=false
Categories=AudioVideo;Video;
Keywords=webcam;camera;discord;fireworks;gesture;
StartupWMClass=local.gesturecam.GestureCam
